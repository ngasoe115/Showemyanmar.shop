# Showemyanmar.shop Self-Hosted Environment Variables

PORT=5000
JWT_SECRET=super-secret-enterprise-jwt-key-2026

# Site Email Identity
SITE_EMAIL=noreply@showemyanmar.shop
SITE_NAME=Showemyanmar.shop

# Local Embedded SMTP Port (Default 1025)
LOCAL_SMTP_PORT=1025

# -------------------------------------------------------------
# REAL EMAIL DELIVERY CONFIGURATION (To send to real inbox e.g. Gmail/Outlook)
# -------------------------------------------------------------
# Option A: Gmail SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-google-app-password

# Option B: Resend / Custom Domain SMTP
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_123456789
